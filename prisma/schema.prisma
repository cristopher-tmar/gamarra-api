generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                Int        @id @default(autoincrement())
  nombres           String     @db.VarChar(100)
  apellidos         String     @db.VarChar(100)
  correo            String     @unique @db.VarChar(150)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  rol               RolUsuario @default(CLIENTE)
  estado            Boolean    @default(true)
  fechaCreacion     DateTime   @default(now()) @map("fecha_creacion")
  fechaModificacion DateTime   @updatedAt @map("fecha_modificacion")

  tiendas               Tienda[]
  sesionesRefresh       SesionRefresh[]
  favoritos             Favorito[]
  eventosComportamiento EventoComportamiento[]

  @@map("usuario")
}

model SesionRefresh {
  id                String    @id @default(uuid()) @db.Uuid
  usuarioId         Int       @map("usuario_id")
  tokenHash         String    @map("token_hash") @db.VarChar(255)
  fechaExpiracion   DateTime  @map("fecha_expiracion")
  fechaRevocacion   DateTime? @map("fecha_revocacion")
  userAgent         String?   @map("user_agent") @db.VarChar(500)
  direccionIp       String?   @map("direccion_ip") @db.VarChar(64)
  fechaCreacion     DateTime  @default(now()) @map("fecha_creacion")
  fechaModificacion DateTime  @updatedAt @map("fecha_modificacion")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([fechaExpiracion])
  @@index([fechaRevocacion])
  @@map("sesion_refresh")
}

model Tienda {
  id                Int      @id @default(autoincrement())
  codigo            String   @unique @db.VarChar(20)
  nombre            String   @db.VarChar(150)
  descripcion       String?  @db.VarChar(500)
  galeria           String   @db.VarChar(150)
  piso              String?  @db.VarChar(20)
  numeroLocal       String   @map("numero_local") @db.VarChar(30)
  telefono          String?  @db.VarChar(20)
  estado            Boolean  @default(true)
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion")
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion")

  productos Producto[]

  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("tienda")
}

model Producto {
  id                Int      @id @default(autoincrement())
  tiendaId          Int      @map("tienda_id")
  codigo            String   @unique @db.VarChar(20)
  nombre            String   @db.VarChar(150)
  categoria         String   @db.VarChar(80)
  descripcion       String?  @db.VarChar(500)
  precio            Decimal  @db.Decimal(10, 2)
  stock             Int      @default(0)
  atributos         Json?
  estado            Boolean  @default(true)
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion")
  fechaModificacion DateTime @updatedAt @map("fecha_modificacion")

  tienda                Tienda                 @relation(fields: [tiendaId], references: [id])
  imagenes              ProductoImagen[]
  favoritos             Favorito[]
  eventosComportamiento EventoComportamiento[]

  @@index([tiendaId])
  @@index([categoria])
  @@map("producto")
}

model ProductoImagen {
  id                  Int                         @id @default(autoincrement())
  productoId          Int                         @map("producto_id")
  url                 String                      @db.VarChar(500)
  nombreAlmacenado    String?                     @map("nombre_almacenado") @db.VarChar(500)
  nombreOriginal      String?                     @map("nombre_original") @db.VarChar(255)
  mimeType            String?                     @map("mime_type") @db.VarChar(100)
  tamanioBytes        Int?                        @map("tamanio_bytes")
  ancho               Int?
  alto                Int?
  hashArchivo         String?                     @map("hash_archivo") @db.VarChar(64)
  embedding           Unsupported("vector(512)")?
  principal           Boolean                     @default(false)
  orden               Int                         @default(1)
  estado              Boolean                     @default(true)
  estadoProcesamiento EstadoProcesamientoImagen   @default(PENDIENTE) @map("estado_procesamiento")
  modeloEmbedding     String?                     @map("modelo_embedding") @db.VarChar(100)
  fechaProcesamiento  DateTime?                   @map("fecha_procesamiento")
  mensajeError        String?                     @map("mensaje_error") @db.VarChar(500)
  fechaCreacion       DateTime                    @default(now()) @map("fecha_creacion")
  fechaModificacion   DateTime                    @updatedAt @map("fecha_modificacion")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, url])
  @@index([productoId])
  @@index([estadoProcesamiento])
  @@map("producto_imagen")
}

model Favorito {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @map("usuario_id")
  productoId    Int      @map("producto_id")
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, productoId])
  @@index([usuarioId])
  @@index([productoId])
  @@index([fechaCreacion])
  @@map("favorito")
}

model EventoComportamiento {
  id              Int                      @id @default(autoincrement())
  tipo            TipoEventoComportamiento
  usuarioId       Int?                     @map("usuario_id")
  productoId      Int?                     @map("producto_id")
  sessionId       String                   @map("session_id") @db.VarChar(100)
  terminoBusqueda String?                  @map("termino_busqueda") @db.VarChar(200)
  metadata        Json?
  fechaEvento     DateTime                 @default(now()) @map("fecha_evento")

  usuario  Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  producto Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  @@index([tipo])
  @@index([usuarioId])
  @@index([productoId])
  @@index([sessionId])
  @@index([fechaEvento])
  @@index([tipo, fechaEvento])
  @@index([productoId, fechaEvento])
  @@index([usuarioId, fechaEvento])
  @@map("evento_comportamiento")
}

enum EstadoProcesamientoImagen {
  PENDIENTE
  PROCESANDO
  PROCESADA
  ERROR
}

enum RolUsuario {
  ADMINISTRADOR
  COMERCIANTE
  CLIENTE
}

enum TipoEventoComportamiento {
  PRODUCTO_VISTO
  FAVORITO_AGREGADO
  FAVORITO_ELIMINADO
  BUSQUEDA_TEXTO
  BUSQUEDA_VISUAL
  RESULTADO_SELECCIONADO
}
